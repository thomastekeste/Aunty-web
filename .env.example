# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Resend (email)
RESEND_API_KEY=re_your_resend_api_key

# Site
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Launch mode — "waitlist" = capture emails, shop accessible but not hero focus;
# "live" = full launch, app download CTAs, shop is primary. Flip to "live" on app approval.
NEXT_PUBLIC_LAUNCH_MODE=waitlist

# Upstash Redis (STRONGLY recommended in production — enables persistent rate
# limiting AND the global daily AI spend cap across serverless cold starts.
# Without it both fall back to per-instance in-memory counters.)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Max total /api/chat completions per UTC day across all users (cost ceiling)
CHAT_DAILY_CAP=1000

# CJ Dropshipping (auto-fulfillment)
CJ_EMAIL=your_cj_account_email
CJ_API_KEY=your_cj_api_key

# Internal API secret (REQUIRED — /api/cj/fulfill now refuses all calls without
# a matching `Authorization: Bearer <this>` header. Set it everywhere.)
INTERNAL_API_SECRET=generate_a_random_string_here

# Admin API (protects sync endpoint)
ADMIN_API_KEY=a_random_secret_key

# Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
