# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Resend (email)
RESEND_API_KEY=re_your_resend_api_key

# Site
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Launch mode — "waitlist" = capture emails, shop accessible but not hero focus;
# "live" = full launch, app download CTAs, shop is primary. Flip to "live" on app approval.
NEXT_PUBLIC_LAUNCH_MODE=waitlist

# Secret that protects the one-time launch blast endpoint (/api/waitlist/launch)
INTERNAL_API_SECRET=a_random_secret_string

# Upstash Redis (optional — enables persistent rate limiting across serverless cold starts)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# CJ Dropshipping (get your API key from app.cjdropshipping.com → Account → API)
CJ_API_KEY=CJUserNum@api@xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin API (protects sync endpoint)
ADMIN_API_KEY=a_random_secret_key

# Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
