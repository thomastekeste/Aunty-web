# Public site URL (used for canonical/OG metadata and sitemap)
NEXT_PUBLIC_SITE_URL=https://auntycurlcouncil.com

# Supabase — public anon key is exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role key is server-only; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — server-only secrets
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
